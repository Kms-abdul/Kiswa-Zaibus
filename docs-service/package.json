{
  "name": "kz-docs",
  "version": "2.8.0",
  "private": true,
  "description": "Kiswa-Zaibus document renderer: Excel and PDF of report tables for the Flask API (release 2.3)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "pdfkit": "0.15.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/pdfkit": "0.13.8",
    "typescript": "5.6.3"
  }
}
