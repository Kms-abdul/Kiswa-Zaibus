# Keep the line endings the code was delivered with (LF) on every machine.
# Linux deploy scripts (deploy/oci/*.sh) and systemd units break with Windows CRLF endings.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# binaries
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.whl binary
*.woff2 binary
*.gz binary
