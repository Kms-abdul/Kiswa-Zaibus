# Kiswa-Zaibus backend configuration.
# On OCI the installer copies this to /etc/kz/kz.env (owner root:kz, mode 640) and links backend/.env to it.
# The same file is read by python-dotenv (backend/kz/config.py) and by systemd (EnvironmentFile=),
# so keep every comment on its own line: systemd does not strip comments written after a value.
# Never commit a real .env.

# ---------------------------------------------------------------- runtime
# production | development | test
KZ_ENV=production
# python3 -c "import secrets;print(secrets.token_hex(32))"   (changing it signs everyone out)
SECRET_KEY=change-me
# The address staff and parents open; used in links inside SMS / e-mail
PUBLIC_URL=https://ops.example.in
# 0 only for plain-http development
COOKIE_SECURE=1
# 1 shows one-time codes in API responses: TEST SERVERS ONLY, never in production
OTP_DEMO=0

# ---------------------------------------------------------------- database (MySQL 8 / OCI MySQL HeatWave)
# HeatWave private endpoint IP, or 127.0.0.1 for MySQL on the same VM
DB_HOST=10.0.1.20
DB_PORT=3306
DB_NAME=kiswa_zaibus
# Runtime account: SELECT/INSERT/UPDATE/DELETE only (deploy/oci/mysql-setup.sql)
DB_USER=kz_app
DB_PASSWORD=
# Path to the CA bundle when the DB system requires TLS, e.g. /etc/kz/heatwave-ca.pem
DB_SSL_CA=
DB_POOL_SIZE=10
# Schema-owner account used ONLY by "alembic upgrade head" (install.sh and update.sh)
MIGRATE_DB_USER=kz_owner
MIGRATE_DB_PASSWORD=

# ---------------------------------------------------------------- files and logs
# Evidence uploads live in $DATA_DIR/evidence (backed up nightly)
DATA_DIR=/var/lib/kz
LOG_DIR=/var/log/kz
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------- gunicorn
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ---------------------------------------------------------------- Razorpay (one account per company). Empty = simulated payments.
RAZORPAY_KEY_ID_KG=
RAZORPAY_KEY_SECRET_KG=
RAZORPAY_WEBHOOK_SECRET_KG=
RAZORPAY_KEY_ID_ZE=
RAZORPAY_KEY_SECRET_ZE=
RAZORPAY_WEBHOOK_SECRET_ZE=

# ---------------------------------------------------------------- outgoing messages (empty = messages stay queued in the outbox)
# OCI Email Delivery SMTP endpoint for your region
SMTP_HOST=smtp.email.ap-hyderabad-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kiswa-Zaibus <no-reply@kiswazaibus.in>
SMTP_TLS=1
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=KZOPS
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ---------------------------------------------------------------- MSEA ERP (students). Empty URL = CSV import only.
ERP_API_URL=
ERP_API_TOKEN=

# Node.js document service (kz-docs, release 2.3): Excel / PDF exports of finance reports.
# Leave DOCS_URL empty to render in Python only. install.sh / update.sh fill DOCS_SECRET when it is empty.
DOCS_URL=http://127.0.0.1:8095
DOCS_SECRET=
DOCS_TIMEOUT=20
