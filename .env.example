# Copy of the settings setup.ps1 writes to backend\.env. You do not normally create this by hand:
# setup.ps1 generates every secret. Shown here so you know what each line does.

# --- database (MySQL 8, localhost only) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kiswa_zaibus
DB_USER=kz_app
DB_PASSWORD=<generated>

# --- secrets (generated; changing SECRET_KEY signs everyone out) ---
SECRET_KEY=<64 hex characters>
INTERNAL_KEY=<64 hex characters, shared by the API and the gateway only>

# --- processes ---
API_HOST=127.0.0.1
API_PORT=5000
GATEWAY_HOST=0.0.0.0            # 127.0.0.1 when IIS or Nginx is in front
GATEWAY_PORT=8080
PUBLIC_HTTPS=0                  # 1 when users reach the site over https (turns on HSTS and upgrade-insecure-requests)
COOKIE_SECURE=0                 # 1 with https; the sign-in cookie is then sent over https only
TLS_PFX_PATH=                   # optional: the gateway serves https itself with this certificate
TLS_PFX_PASSWORD=
OTP_DEMO=0                      # 1 shows sign-in codes on screen - test servers only

# --- folders ---
DATA_DIR=C:\KiswaZaibus\data
EVIDENCE_DIR=C:\KiswaZaibus\data\evidence
LOG_DIR=C:\KiswaZaibus\logs
MYSQL_BIN=C:\KiswaZaibus\mysql\bin
BACKUP_DIR=C:\KiswaZaibus\data\backups
BACKUP_KEEP_DAYS=30

# --- outgoing messages (sign-in codes, alerts) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@kiswazaibus.in
SMTP_PASSWORD=
SMTP_FROM=Kiswa-Zaibus <no-reply@kiswazaibus.in>
SMS_API_URL=                    # provider endpoint that accepts POST {"to","sender","message"} with a Bearer key
SMS_API_KEY=
SMS_SENDER_ID=KZOPS
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Razorpay (webhook secrets from each company's Razorpay dashboard) ---
# Webhook URLs to register: https://<your site>/webhooks/razorpay/KG and .../ZE
RAZORPAY_WEBHOOK_SECRET_KG=
RAZORPAY_WEBHOOK_SECRET_ZE=
